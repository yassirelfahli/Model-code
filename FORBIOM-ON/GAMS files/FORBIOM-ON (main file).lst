 902   
 903  * =========================================================================
 904  * 12. CARBON PRICE SENSITIVITY
 905  * =========================================================================
 906  LOOP(cpScen,
 907      carbonPrice = cpValue(cpScen);
 908      SOLVE ForestCP USING NLP MAXIMIZING obj;
 909   
 910      sensSummary(cpScen,'Obj')             = obj.l;
 911      sensSummary(cpScen,'Zprofit')         = Zprofit.l;
 912      sensSummary(cpScen,'Zemission')       = Zemission.l;
 913      sensSummary(cpScen,'CarbonStorage')   = Zstorage.l;
 914      sensSummary(cpScen,'NetCarbon')       = ZnetCarbon.l;
 915      sensSummary(cpScen,'CarbonCost')      = carbonCost.l;
 916      sensSummary(cpScen,'Revenue')         = revenue.l;
 917      sensSummary(cpScen,'HarvestCost')     = harvestCostTot.l;
 918      sensSummary(cpScen,'ProcCost')        = procCostTot.l;
 919      sensSummary(cpScen,'TransCost')       = transCostTot.l;
 920      sensSummary(cpScen,'TotalHarvest')    = sum((r,y), harvestRW.l(r,y));
 921      sensSummary(cpScen,'TotalProduction') = sum((r,p,y), production.l(r,p,y));
 922      sensSummary(cpScen,'TotalSales')      = sum((r,p,y), sales.l(r,p,y));
 923  );
 924  * NetCarbon delta / % vs cp170 — shows emissions/storage components move with Obj even when NetCarbon is unchanged
 925  LOOP(cpScen,
 926      sensSummary(cpScen,'NetCarbDel') = sensSummary(cpScen,'NetCarbon') - sensSummary('cp170','NetCarbon');
 927  );
 928  LOOP(cpScen,
 929      sensSummary(cpScen,'NetCarbPct')$(abs(sensSummary('cp170','NetCarbon')) > 1e-6)
 930          = 100 * sensSummary(cpScen,'NetCarbDel') / abs(sensSummary('cp170','NetCarbon'));
 931  );
 932  sensSummary(cpScen,'NetCarbPct')$(abs(sensSummary('cp170','NetCarbon')) <= 1e-6) = 0;
 933   
 934  sensForPlot(cpScen,'CarbonPrice')     = cpValue(cpScen);
 935  sensForPlot(cpScen,'Obj')             = sensSummary(cpScen,'Obj');
 936  sensForPlot(cpScen,'Zprofit')         = sensSummary(cpScen,'Zprofit');
 937  sensForPlot(cpScen,'Zemission')       = sensSummary(cpScen,'Zemission');
 938  sensForPlot(cpScen,'CarbonCost')      = sensSummary(cpScen,'CarbonCost');
 939  sensForPlot(cpScen,'Revenue')         = sensSummary(cpScen,'Revenue');
 940  sensForPlot(cpScen,'HarvestCost')     = sensSummary(cpScen,'HarvestCost');
 941  sensForPlot(cpScen,'ProcCost')        = sensSummary(cpScen,'ProcCost');
 942  sensForPlot(cpScen,'TransCost')       = sensSummary(cpScen,'TransCost');
 943  sensForPlot(cpScen,'TotalHarvest')    = sensSummary(cpScen,'TotalHarvest');
 944  sensForPlot(cpScen,'TotalProduction') = sensSummary(cpScen,'TotalProduction');
 945  sensForPlot(cpScen,'TotalSales')      = sensSummary(cpScen,'TotalSales');
 946   
 947  sensBase(outMet) = sensSummary('cp170',outMet);
 948  sensDelta(cpScen,outMet,'AbsChange') = sensSummary(cpScen,outMet) - sensBase(outMet);
 949  sensDelta(cpScen,outMet,'PctChange')$sensBase(outMet) = 100 * sensDelta(cpScen,outMet,'AbsChange') / sensBase(outMet);
 950   
 951  DISPLAY cpValue, sensSummary, sensForPlot;
 952  DISPLAY sensBase, sensDelta;
 953   
