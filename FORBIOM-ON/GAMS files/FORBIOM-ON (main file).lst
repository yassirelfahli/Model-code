 858  cmrep.pc = 5;
 859  cmrep.nd = 12;
 860  put cmrep;
 861  put 'Coupled sensitivity - MT demand (CLT+Glulam) x lumber price, 6 regions'/;
 862  put /;
 863  loop(cmScen,
 864      put 'Scenario: ' cmScen.tl /;
 865      put '  CLTdemMult ' cmDemandMult(cmScen,'CLT'):12:4
 866          '  LumberMult ' cmLumberMult(cmScen):12:4
 867          '  Obj ' cmObj(cmScen):12:4
 868          '  TotQty ' cmTotQty(cmScen):12:2
 869          '  TotRev ' cmTotRev(cmScen):12:4 /;
 870      loop(r,
 871          put '  ' r.tl:12
 872              ' Qty ' cmTableQty(cmScen,r):12:2
 873              ' Rev ' cmTableRev(cmScen,r):12:4 /;
 874      );
 875      put /;
 876  );
 877  putclose cmrep;
 878  put_utility 'log' / 'Wrote output/coupled_sensitivity_report.txt';
