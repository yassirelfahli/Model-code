G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  * =========================================================================
   2  * FORBIOM MODEL
   3  * - logistics constraints include arc capacities + mill capacities
   4  * - prices are FIXED to exogenous basePrice_y path
   5  * - all economic flow variables are in MILLION m3
   6  * - prices/costs are in $/m3
   7  * - objective and totals are therefore in MILLION $
   8  * =========================================================================
   9   
  10  * =========================================================================
  11  * 1. MODEL STRUCTURE (SETS)
  12  * =========================================================================
  13  SETS
  14      r       "Regions" /TroutLake, Abitibi, Algoma, Kenora, Nipissing, Algonquin/
  15      p       "Products" /CLT, Glulam, Lumber, Pulpwood/
  16      y       "Years" /2020*2030/
  17      tree    "Tree Species" /Spruce, JackPine, WhiteBirch, TolerantHdwds, WhitePine, RedPine, Aspen/
  18      s       "Site Class" /SC1, SC2, SC3/
  19      age     "Forest Age" /0*150/
  20      m       "Manufacturing layers" /Primary, Secondary/
  21      met     "Tier metrics" /Production, Revenue, ProcessingCost/
  22      comp    "Product chain cost components" /BaseProcessing, ProductMarkup, LumberInputCost, Total/
  23      cpScen  "Carbon price sensitivity scenarios" /cp0, cp50, cp100, cp170, cp250, cp350, cp500/
  24      outMet  "Sensitivity output metrics"
  25              /Obj, Zprofit, Zemission, CarbonStorage, NetCarbon, NetCarbDel, NetCarbPct,
  26               CarbonCost, Revenue, HarvestCost, ProcCost, TransCost, TotalHarvest, TotalProduction, TotalSales/
  27      chgMet  "Change metrics for scenario deltas" /AbsChange, PctChange/
  28      demCol  "Demand-sensitivity chart columns (same layout as former mt chart)" /DemandMultiplierCLTGlulam, Obj, Zprofit, Zemission, CarbonCost, Revenue, HarvestCost, ProcCost, TransCost, TotalHarvest, TotalProduction, TotalSales/
  29      demScen "Demand-change scenarios (Table 3 style, 6 regions)" /Baseline, D50, D100, D200, D300, D400, DU10/
  30      pubRow  "Publication summary rows: carb_* = carbon-price sweep; dem_* = demand sweep at cp170"
  31              / carb_cp0, carb_cp50, carb_cp100, carb_cp170, carb_cp250, carb_cp350, carb_cp500
  32                dem_Baseline, dem_D50, dem_D100, dem_D200, dem_D300, dem_D400, dem_DU10 /
  33      tabSumCol(outMet) "Pub table: Obj, gross em., stored C, net C, delta & pct vs ref, harvest" /Obj, Zemission, CarbonStorage, NetCarbon, NetCarbDel, NetCarbPct, TotalHarvest/
  34      prScen  "Lumber price sensitivity scenarios" /Pbase, PD5, PI5, PD10, PI10/
  35      cmScen  "Coupled demand + lumber price scenarios" /CM_D100_PD5, CM_D100_PI10, CM_D200_PD10/;
  36   
  37  ALIAS (r, rr);
  38   
  39  SET pubCarbRow(pubRow, cpScen) /
  40      carb_cp0.cp0, carb_cp50.cp50, carb_cp100.cp100, carb_cp170.cp170
  41      carb_cp250.cp250, carb_cp350.cp350, carb_cp500.cp500
  42  /;
  43   
  44  SET pubDemRow(pubRow, demScen) /
  45      dem_Baseline.Baseline, dem_D50.D50, dem_D100.D100, dem_D200.D200
  46      dem_D300.D300, dem_D400.D400, dem_DU10.DU10
  47  /;
  48   
  49  * =========================================================================
  50  * 2. DATA INPUT: YIELD TABLES (Plonski Volume m3/ha)
  51  * =========================================================================
  52  PARAMETER YieldData(tree, s, age) "Gross Merchantable Volume (m3/ha)";
  53   
  54  * [DATA INPUT: WHITE PINE SC1]
  55  YieldData('WhitePine', 'SC1', '30') = 76;   YieldData('WhitePine', 'SC1', '40') = 157;
  56  YieldData('WhitePine', 'SC1', '50') = 242;  YieldData('WhitePine', 'SC1', '60') = 315;
  57  YieldData('WhitePine', 'SC1', '70') = 372;  YieldData('WhitePine', 'SC1', '80') = 414;
  58   
  59  * [DATA INPUT: JACK PINE SC1]
  60  YieldData('JackPine', 'SC1', '30') = 89;    YieldData('JackPine', 'SC1', '40') = 155;
  61  YieldData('JackPine', 'SC1', '50') = 196;   YieldData('JackPine', 'SC1', '60') = 223;
  62  YieldData('JackPine', 'SC1', '70') = 238;   YieldData('JackPine', 'SC1', '80') = 243;
  63   
  64  * [DATA INPUT: TOLERANT HARDWOODS SC1]
  65  YieldData('TolerantHdwds', 'SC1', '30') = 36;
  66  YieldData('TolerantHdwds', 'SC1', '40') = 68;
  67  YieldData('TolerantHdwds', 'SC1', '50') = 100;
  68  YieldData('TolerantHdwds', 'SC1', '60') = 130;
  69  YieldData('TolerantHdwds', 'SC1', '70') = 158;
  70  YieldData('TolerantHdwds', 'SC1', '80') = 185;
  71   
  72  * [DATA INPUT: SITE CLASS PROXIES]
  73  YieldData(tree, 'SC2', age) = YieldData(tree, 'SC1', age) * 0.80;
  74  YieldData(tree, 'SC3', age) = YieldData(tree, 'SC1', age) * 0.60;
  75   
  76  * [DATA INPUT: SPECIES PROXIES]
  77  YieldData('RedPine', s, age)    = YieldData('WhitePine', s, age);
  78  YieldData('Spruce', s, age)     = YieldData('JackPine', s, age);
  79  YieldData('Aspen', s, age)      = YieldData('JackPine', s, age) * 0.9;
  80  YieldData('WhiteBirch', s, age) = YieldData('JackPine', s, age) * 0.8;
  81   
  82  * =========================================================================
  83  * 3. REGIONAL PARAMETERS
  84  * =========================================================================
  85  TABLE speciesMix(r, tree) "Forest Composition (%)"
  86                 Spruce  JackPine WhiteBirch TolerantHdwds WhitePine RedPine Aspen
  87      TroutLake   0.50    0.30     0.10       0.00          0.00      0.00    0.10
  88      Abitibi     0.60    0.20     0.10       0.00          0.00      0.00    0.10
  89      Kenora      0.40    0.40     0.10       0.00          0.00      0.05    0.05
  90      Algoma      0.10    0.05     0.10       0.40          0.30      0.05    0.00
  91      Nipissing   0.10    0.05     0.10       0.30          0.40      0.05    0.00
  92      Algonquin   0.05    0.00     0.10       0.50          0.30      0.05    0.00;
  93   
  94  PARAMETERS
  95      initialAge(r)        /TroutLake 30, Abitibi 30, Algoma 30, Kenora 30, Nipissing 30, Algonquin 30/
  96      initialStockRegion(r) "Initial ROUNDWOOD stock (MILLION m3)"
  97                           /TroutLake 28999.48, Abitibi 107775.22, Algoma 54884.89, Kenora 49746.19, Nipissing 45261.69, Algonquin 36725.26/;
  98   
  99  SET regionSite(r, s) "Dominant site class"
 100  /
 101      TroutLake.SC2
 102      Abitibi.SC2
 103      Algoma.SC1
 104      Kenora.SC3
 105      Nipissing.SC1
 106      Algonquin.SC1
 107  /;
 108   
 109   
 110  PARAMETERS
 111      regionArea(r)   "Calculated hectares"
 112      CAI_Region(r,y) "Annual roundwood growth (MILLION m3/year)"
 113      initStockRW(r)  "Initial roundwood stock (MILLION m3)"
 114      growthRW(r,y)   "Roundwood growth (MILLION m3/year)";
 115   
 116  regionArea(r) =
 117      (initialStockRegion(r) * 1000000)
 118      /
 119      sum((tree, age, s)$(ord(age)-1 = initialAge(r) and regionSite(r, s)),
 120          speciesMix(r, tree) * YieldData(tree, s, age));
 121   
 122  LOOP(y,
 123     LOOP(r,
 124        CAI_Region(r, y) =
 125           sum(tree,
 126               speciesMix(r, tree) *
 127               (
 128                 sum((age, s)$(ord(age)-1 = initialAge(r) + 10 and regionSite(r, s)), YieldData(tree, s, age))
 129               - sum((age, s)$(ord(age)-1 = initialAge(r)      and regionSite(r, s)), YieldData(tree, s, age))
 130               )
 131           ) / 10 * regionArea(r) / 1000000;
 132     );
 133  );
 134   
 135  initStockRW(r) = initialStockRegion(r);
 136   
 137  * Stochastic growth shock (climate, disturbance, measurement) - reproducible
 138  * Range ~0.88 to 1.12 (±12%) for realistic interannual variability
 139  SCALAR growthShockMin /0.88/, growthShockMax /1.12/;
 140  PARAMETER growthShock(r,y) "Annual growth multiplier (region- and year-specific)";
 141  growthShock(r,y) = growthShockMin + (growthShockMax - growthShockMin)
 142      * mod(ord(r)*31 + ord(y)*17 + 7, 97) / 97;
 143  growthRW(r,y)  = CAI_Region(r,y) * growthShock(r,y);
 144   
 145  * Stochastic harvest cost shock - region- and year-specific, non-deterministic
 146  * Range ~0.90 to 1.10 (±10%). Use LOOP so each (r,y) gets independent uniform draw.
 147  * For reproducibility: gams SA4.gms --seed=N
 148  SCALAR harvestCostShockMin /0.90/, harvestCostShockMax /1.10/;
 149  PARAMETER harvestCostShock(r,y) "Harvest cost multiplier by region and year"
 150            harvestCost_y(r,y)    "Harvest cost by region and year ($/m3)";
 151  LOOP((r,y),
 152      harvestCostShock(r,y) = uniform(harvestCostShockMin, harvestCostShockMax);
 153  );
 154   
 155  * =========================================================================
 156  * 4. ECONOMIC / VALUE-CHAIN PARAMETERS
 157  * =========================================================================
 158  SCALARS
 159      carbonPrice   "Carbon price ($/tCO2)" /170/
 160      demandGrowth  "Annual demand growth rate" /0.00/;
 161   
 162  PARAMETERS
 163      manufacturingTier(p) "1=Primary, 2=Secondary"
 164                           /CLT 2, Glulam 2, Lumber 1, Pulpwood 1/
 165   
 166      maxHarvestRate(r)    "Max sustainable harvest ratio"
 167                           /Abitibi 0.01, Algoma 0.01, Algonquin 0.01, Kenora 0.01, Nipissing 0.01, TroutLake 0.01/
 168   
 169      basePrice(p)         "Base price ($/m3)"
 170                           /CLT 700, Glulam 575, Lumber 375, Pulpwood 75/
 171   
 172      yieldFactor(p)       "Output per unit of primary raw-material input"
 173                           /CLT 0.82, Glulam 0.85, Lumber 0.90, Pulpwood 0.98/
 174   
 175      lumberInputPerUnit(p) "m3 lumber required per m3 product"
 176                           /CLT 1.20, Glulam 1.10, Lumber 0, Pulpwood 0/
 177   
 178      baseProcessingCost(m) "Base processing cost by layer ($/m3 output)"
 179                            /Primary 100, Secondary 50/
 180   
 181      productMarkup(p)      "Additional product-specific processing cost ($/m3 output)"
 182                            /CLT 150, Glulam 120, Lumber 20, Pulpwood -80/
 183   
 184      processingCost_y(p, y) "Processing cost over time ($/m3 output)"
 185      basePrice_y(p, y)      "Exogenous price path ($/m3)"
 186      demandCap_y(r,p,y)     "Max final demand served (MILLION m3/year)"
 187      baseDemand(r,p)        "Base final demand cap (MILLION m3/year)"
 188      cpValue(cpScen)        "Carbon price by scenario ($/tCO2)"
 189      demandCapBase(r,p,y)   "Stored baseline demand cap"
 190      demandShock(r,p,y)     "Stochastic demand multiplier by region/product/year"
 191      basePricePath(p,y)     "Frozen reference price path (before scenario shocks)";
 192   
 193  cpValue('cp0')   = 0;
 194  cpValue('cp50')  = 50;
 195  cpValue('cp100') = 100;
 196  cpValue('cp170') = 170;
 197  cpValue('cp250') = 250;
 198  cpValue('cp350') = 350;
 199  cpValue('cp500') = 500;
 200   
 201  * Processing cost: NO fake embedded lumber cost here
 202  processingCost_y(p, y) =
 203      (
 204        (baseProcessingCost('Primary')   + productMarkup(p))$(manufacturingTier(p)=1)
 205      + (baseProcessingCost('Secondary') + productMarkup(p))$(manufacturingTier(p)=2)
 206      ) * power(0.98, ord(y)-1);
 207   
 208  * Exogenous product prices grow 3% annually
 209  basePrice_y(p, y) = basePrice(p) * power(1.03, ord(y)-1);
 210   
 211  baseDemand(r,p) = 0;
 212   
 213  * Lumber demand
 214  baseDemand('Nipissing','Lumber') = 6.5;  baseDemand('Abitibi','Lumber') = 5.0;
 215  baseDemand('Algoma','Lumber')    = 4.5;  baseDemand('Algonquin','Lumber') = 4.0;
 216  baseDemand('TroutLake','Lumber') = 3.5;  baseDemand('Kenora','Lumber') = 2.5;
 217   
 218  * Pulpwood demand
 219  baseDemand('Nipissing','Pulpwood') = 7.0; baseDemand('Abitibi','Pulpwood') = 6.0;
 220  baseDemand('Algoma','Pulpwood')    = 5.0; baseDemand('Algonquin','Pulpwood') = 4.0;
 221  baseDemand('TroutLake','Pulpwood') = 3.0; baseDemand('Kenora','Pulpwood') = 2.0;
 222   
 223  * CLT / Glulam demand
 224  baseDemand(r,'CLT')    = 0.17;
 225  baseDemand(r,'Glulam') = 0.17;
 226   
 227  * Stochastic demand shock (market, policy) - makes harvestRW vary by year/region
 228  * Range ~0.88 to 1.12. Use --seed=N for reproducibility.
 229  LOOP((r,p,y),
 230      demandShock(r,p,y) = uniform(0.88, 1.12);
 231  );
 232  demandCap_y(r,p,y) = baseDemand(r,p) * power(1 + demandGrowth, ord(y)-1) * demandShock(r,p,y);
 233  demandCapBase(r,p,y) = demandCap_y(r,p,y);
 234  * Reference price path for price / coupled sensitivity (lumber shock only unless noted)
 235  basePricePath(p,y) = basePrice_y(p,y);
 236   
 237  * Demand-change multipliers (CLT/Glulam only; other p stay 1) — Michigan-style labels
 238  PARAMETER demDemandMult(demScen,p) "Multiplier on demandCap for demand scenarios";
 239  demDemandMult(demScen,p) = 1;
 240  * Baseline = base caps; D50 = +50% MT demand, ... D400 = +400%; DU10 = +10% (tune for "US share" story)
 241  demDemandMult('Baseline','CLT') = 1.00;  demDemandMult('Baseline','Glulam') = 1.00;
 242  demDemandMult('D50','CLT')      = 1.50;  demDemandMult('D50','Glulam')      = 1.50;
 243  demDemandMult('D100','CLT')     = 2.00;  demDemandMult('D100','Glulam')     = 2.00;
 244  demDemandMult('D200','CLT')     = 3.00;  demDemandMult('D200','Glulam')     = 3.00;
 245  demDemandMult('D300','CLT')     = 4.00;  demDemandMult('D300','Glulam')     = 4.00;
 246  demDemandMult('D400','CLT')     = 5.00;  demDemandMult('D400','Glulam')     = 5.00;
 247  demDemandMult('DU10','CLT')     = 1.10;  demDemandMult('DU10','Glulam')     = 1.10;
 248   
 249  * Lumber price multipliers (exogenous path for Lumber only; other products unchanged)
 250  PARAMETER prLumberMult(prScen) "Multiplier on basePricePath for Lumber";
 251  prLumberMult(prScen) = 1;
 252  prLumberMult('Pbase') = 1.00;
 253  prLumberMult('PD5')   = 0.95;
 254  prLumberMult('PI5')   = 1.05;
 255  prLumberMult('PD10')  = 0.90;
 256  prLumberMult('PI10')  = 1.10;
 257   
 258  * Coupled: MT demand (CLT/Glulam) + lumber price shock together
 259  PARAMETER cmDemandMult(cmScen,p) "Demand cap multiplier for coupled runs"
 260            cmLumberMult(cmScen)   "Lumber price multiplier for coupled runs";
 261  cmDemandMult(cmScen,p) = 1;
 262  cmDemandMult('CM_D100_PD5','CLT')    = 2.00;
 263  cmDemandMult('CM_D100_PD5','Glulam') = 2.00;
 264  cmLumberMult('CM_D100_PD5')          = 0.95;
 265  cmDemandMult('CM_D100_PI10','CLT')    = 2.00;
 266  cmDemandMult('CM_D100_PI10','Glulam') = 2.00;
 267  cmLumberMult('CM_D100_PI10')          = 1.10;
 268  cmDemandMult('CM_D200_PD10','CLT')    = 3.00;
 269  cmDemandMult('CM_D200_PD10','Glulam') = 3.00;
 270  cmLumberMult('CM_D200_PD10')          = 0.90;
 271   
 272  * =========================================================================
 273  * 5. TRANSPORT / LOGISTICS
 274  * =========================================================================
 275  TABLE transportBase(r,rr) "Transport cost proxy ($/m3)"
 276                  TroutLake Abitibi Algoma Kenora Nipissing Algonquin
 277      TroutLake       0        38      42     100      14         9
 278      Abitibi        26         0      35      75      25        32
 279      Algoma         31        28       0      60      31        38
 280      Kenora         79        61      49       0      79        87
 281      Nipissing      14        27      31      79       0         8
 282      Algonquin       9        34      38      87       8         0;
 283   
 284  PARAMETERS
 285      transportCost(r,rr,p)          "Transport cost by product ($/m3)"
 286      arcCap(r,rr,p,y)               "Arc capacity (MILLION m3/year) (shipments cannot exceed transport capacity)"
 287      millCap(r,p,y)                 "Mill output capacity (MILLION m3/year)"
 288      harvestCostRW                  "Harvest cost for roundwood ($/m3)"
 289      carbonEmissionFactor(p)        "Process emission factor (tCO2/m3 output)"
 290      carbonStorageFactor(p)         "Stored carbon factor (tCO2/m3 output)"
 291      transportEmissionFactor(r,rr,p) "Freight emission factor (tCO2/m3 shipped)";
 292   
 293  transportCost(r,rr,p)$(not sameas(r,rr)) = transportBase(r,rr);
 294   
 295  * Placeholder capacities: will be replace with real data when available
 296  arcCap(r,rr,p,y)$(not sameas(r,rr)) = 20;
 297   
 298  millCap(r,'Lumber',y)   = 10;
 299  millCap(r,'Pulpwood',y) = 10;
 300  millCap(r,'CLT',y)      = 1.0;
 301  millCap(r,'Glulam',y)   = 1.0;
 302   
 303  harvestCostRW = 38;
 304  harvestCost_y(r,y) = harvestCostRW * harvestCostShock(r,y);
 305   
 306  carbonEmissionFactor('CLT')      = 0.15;
 307  carbonEmissionFactor('Glulam')   = 0.17;
 308  carbonEmissionFactor('Lumber')   = 0.065;
 309  carbonEmissionFactor('Pulpwood') = 0.01;
 310   
 311  carbonStorageFactor('CLT')      = 0.7;
 312  carbonStorageFactor('Glulam')   = 0.7;
 313  carbonStorageFactor('Lumber')   = 0.4;
 314  carbonStorageFactor('Pulpwood') = 0.07;
 315   
 316  transportEmissionFactor(r,rr,p)$(not sameas(r,rr)) = 0.018;
 317   
 318  * =========================================================================
 319  * 6. VARIABLES
 320  * =========================================================================
 321  POSITIVE VARIABLES
 322      stockRW(r,y)          "Roundwood stock (MILLION m3)"
 323      harvestRW(r,y)        "Roundwood harvest (MILLION m3)"
 324      production(r,p,y)     "Output production (MILLION m3)"
 325      sales(r,p,y)          "Final sales / served demand (MILLION m3)"
 326      exports(r,rr,p,y)     "Interregional shipments (MILLION m3)"
 327      price(r,p,y)          "Price variable fixed to exogenous path ($/m3)"
 328      carbonStorage(r,p,y)  "Stored carbon (MtCO2 eq if factors are tCO2/m3 and quantities in million m3)"
 329      carbonEmission(r,p,y) "Emissions (MtCO2 eq)";
 330   
 331  VARIABLES
 332      Zprofit        "Net economic value before carbon cost (MILLION $)"
 333      Zemission      "Total carbon emissions (MtCO2 eq)"
 334      Zstorage       "Total stored carbon (MtCO2 eq)"
 335      ZnetCarbon     "Net carbon = emissions - storage (MtCO2 eq)"
 336      carbonCost     "Carbon cost (MILLION $)"
 337      obj            "Objective = Zprofit - carbonCost (MILLION $)"
 338      revenue        "Revenue (MILLION $)"
 339      harvestCostTot "Harvest cost (MILLION $)"
 340      procCostTot    "Processing cost (MILLION $)"
 341      transCostTot   "Transport cost (MILLION $)";
 342   
 343  * =========================================================================
 344  * 7. EQUATIONS
 345  * =========================================================================
 346  EQUATIONS
 347      stockBalanceRW(r,y)
 348      sustainabilityRW(r,y)
 349      roundwoodUseEq(r,y)
 350      millCapacityEq(r,p,y)
 351      demandCapEq(r,p,y)
 352      arcCapEq(r,rr,p,y)
 353      lumberBalance(r,y)
 354      pulpwoodBalance(r,y)
 355      cltBalance(r,y)
 356      glulamBalance(r,y)
 357      carbonStoreEq(r,p,y)
 358      carbonEmitEq(r,p,y)
 359      emissionEq
 360      storageEq
 361      netCarbonEq
 362      eCarbonCost
 363      revenueEq
 364      harvestCostEq
 365      procCostEq
 366      transCostEq
 367      profitEq
 368      scalarObjective;
 369   
 370  stockBalanceRW(r,y)..
 371      stockRW(r,y) =E=
 372            (initStockRW(r) - harvestRW(r,y))$(ord(y)=1)
 373          + (stockRW(r,y-1) + growthRW(r,y) - harvestRW(r,y))$(ord(y)>1);
 374   
 375  sustainabilityRW(r,y)..
 376      harvestRW(r,y) =L=
 377            maxHarvestRate(r) * initStockRW(r)$(ord(y)=1)
 378          + maxHarvestRate(r) * (stockRW(r,y-1) + growthRW(r,y))$(ord(y)>1);
 379   
 380  * Roundwood can only feed primary processing (Lumber + Pulpwood)
 381  roundwoodUseEq(r,y)..
 382        production(r,'Lumber',y)   / yieldFactor('Lumber')
 383      + production(r,'Pulpwood',y) / yieldFactor('Pulpwood')
 384      =L= harvestRW(r,y);
 385   
 386  millCapacityEq(r,p,y)..
 387      production(r,p,y) =L= millCap(r,p,y);
 388   
 389  demandCapEq(r,p,y)..
 390      sales(r,p,y) =L= demandCap_y(r,p,y);
 391   
 392  arcCapEq(r,rr,p,y)$(not sameas(r,rr))..
 393      exports(r,rr,p,y) =L= arcCap(r,rr,p,y);
 394   
 395  * Lumber balance: final lumber sales + lumber shipments + lumber used in CLT/Glulam
 396  lumberBalance(r,y)..
 397        production(r,'Lumber',y)
 398      + sum(rr$(not sameas(r,rr)), exports(rr,r,'Lumber',y))
 399      =E=
 400        sales(r,'Lumber',y)
 401      + sum(rr$(not sameas(r,rr)), exports(r,rr,'Lumber',y))
 402      + lumberInputPerUnit('CLT')    * production(r,'CLT',y)
 403      + lumberInputPerUnit('Glulam') * production(r,'Glulam',y);
 404   
 405  pulpwoodBalance(r,y)..
 406        production(r,'Pulpwood',y)
 407      + sum(rr$(not sameas(r,rr)), exports(rr,r,'Pulpwood',y))
 408      =E=
 409        sales(r,'Pulpwood',y)
 410      + sum(rr$(not sameas(r,rr)), exports(r,rr,'Pulpwood',y));
 411   
 412  cltBalance(r,y)..
 413        production(r,'CLT',y)
 414      + sum(rr$(not sameas(r,rr)), exports(rr,r,'CLT',y))
 415      =E=
 416        sales(r,'CLT',y)
 417      + sum(rr$(not sameas(r,rr)), exports(r,rr,'CLT',y));
 418   
 419  glulamBalance(r,y)..
 420        production(r,'Glulam',y)
 421      + sum(rr$(not sameas(r,rr)), exports(rr,r,'Glulam',y))
 422      =E=
 423        sales(r,'Glulam',y)
 424      + sum(rr$(not sameas(r,rr)), exports(r,rr,'Glulam',y));
 425   
 426  carbonStoreEq(r,p,y)..
 427      carbonStorage(r,p,y) =E= carbonStorageFactor(p) * production(r,p,y);
 428   
 429  carbonEmitEq(r,p,y)..
 430      carbonEmission(r,p,y) =E=
 431          carbonEmissionFactor(p) * production(r,p,y)
 432        + sum(rr$(not sameas(r,rr)), transportEmissionFactor(r,rr,p) * exports(r,rr,p,y));
 433   
 434  emissionEq..
 435      Zemission =E= sum((r,p,y), carbonEmission(r,p,y));
 436   
 437  storageEq..
 438      Zstorage =E= sum((r,p,y), carbonStorage(r,p,y));
 439   
 440  netCarbonEq..
 441      ZnetCarbon =E= Zemission - Zstorage;
 442   
 443  * Carbon charge on gross emissions only (ZnetCarbon still available for reporting)
 444  eCarbonCost..
 445      carbonCost =E= carbonPrice * Zemission;
 446   
 447  revenueEq..
 448      revenue =E= sum((r,p,y), price(r,p,y) * sales(r,p,y));
 449   
 450  harvestCostEq..
 451      harvestCostTot =E= sum((r,y), harvestCost_y(r,y) * harvestRW(r,y));
 452   
 453  procCostEq..
 454      procCostTot =E= sum((r,p,y), processingCost_y(p,y) * production(r,p,y));
 455   
 456  transCostEq..
 457      transCostTot =E= sum((r,rr,p,y)$(not sameas(r,rr)), transportCost(r,rr,p) * exports(r,rr,p,y));
 458   
 459  profitEq..
 460      Zprofit =E= revenue - harvestCostTot - procCostTot - transCostTot;
 461   
 462  scalarObjective..
 463      obj =E= Zprofit - carbonCost;
 464   
 465  * =========================================================================
 466  * 8. BOUNDS / FIXED PRICES / INITIAL LEVELS
 467  * =========================================================================
 468  * Fix prices to the exogenous 3% growth path
 469  price.fx(r,p,y) = basePrice_y(p,y);
 470   
 471  * No within-region shipments
 472  exports.fx(r,r,p,y) = 0;
 473   
 474  * Keep some stock floor in 2025 if you want a policy constraint
 475  stockRW.lo(r,y)$(y.val >= 2025) = 0.5 * initStockRW(r);
 476   
 477  * Starting levels
 478  stockRW.l(r,y)      = initStockRW(r);
 479  harvestRW.l(r,y)    = maxHarvestRate(r) * initStockRW(r);
 480  production.l(r,p,y) = 0.25 * demandCap_y(r,p,y);
 481  sales.l(r,p,y)      = 0.25 * demandCap_y(r,p,y);
 482  exports.l(r,rr,p,y)$(not sameas(r,rr)) = 0;
 483   
 484  * =========================================================================
 485  * 9. MODEL AND SOLVE
 486  * =========================================================================
 487  MODEL ForestCP /
 488      stockBalanceRW, sustainabilityRW, roundwoodUseEq,
 489      millCapacityEq, demandCapEq, arcCapEq,
 490      lumberBalance, pulpwoodBalance, cltBalance, glulamBalance,
 491      carbonStoreEq, carbonEmitEq,
 492      emissionEq, storageEq, netCarbonEq, eCarbonCost,
 493      revenueEq, harvestCostEq, procCostEq, transCostEq,
 494      profitEq, scalarObjective
 495  /;
 496   
 497  SOLVE ForestCP USING NLP MAXIMIZING obj;
 498   
 499  * =========================================================================
 500  * 10. REPORTING
 501  * =========================================================================
 502  PARAMETER
 503      tierMetrics(r,m,met,y)      "Manufacturing layer metrics"
 504      productChainCost(p,comp,y)  "Product cost breakdown"
 505      revRPY(r,p,y)               "Revenue by region/product/year (MILLION $)"
 506      revR(r)                     "Total revenue by region (MILLION $)"
 507      rev2025(r)                  "Revenue by region in 2025 (MILLION $)"
 508      sensSummary(cpScen,outMet)  "Carbon-price sensitivity summary"
 509      sensForPlot(cpScen,*)       "Chart-ready carbon sensitivity table"
 510      sensBase(outMet)            "Carbon sensitivity baseline values at cp170"
 511      sensDelta(cpScen,outMet,chgMet) "Carbon sensitivity delta vs cp170"
 512      demSummary(demScen,outMet)    "Demand-scenario full metrics (at reference carbon price)"
 513      demForChart(demScen,demCol)   "Chart-ready demand sensitivity (D50-style labels)"
 514      demSensBase(outMet)           "Demand sensitivity baseline = Baseline demScen"
 515      demSensDelta(demScen,outMet,chgMet) "Demand delta vs Baseline demScen"
 516      demTableQty(demScen,r) "Mass timber CLT+Glulam, sum over years (1000 m3)"
 517      demTableRev(demScen,r) "Direct output CLT+Glulam sales revenue, sum over years (MILLION $)"
 518      demObj(demScen)       "Objective after each demand scenario (MILLION $)"
 519      demTotQty(demScen)    "Total mass-timber qty all regions (1000 m3)"
 520      demTotRev(demScen)    "Total CLT+Glulam revenue all regions (MILLION $)"
 521      demForPlot(demScen,*) "Compact demand-sensitivity table for DISPLAY"
 522      prTableQty(prScen,r)  "Price sens: mass timber qty sum years (1000 m3)"
 523      prTableRev(prScen,r)   "Price sens: CLT+Glulam revenue sum years (MILLION $)"
 524      prObj(prScen)          "Price sens: objective (MILLION $)"
 525      prTotQty(prScen)       "Price sens: total MT qty all regions (1000 m3)"
 526      prTotRev(prScen)       "Price sens: total MT rev (MILLION $)"
 527      prForPlot(prScen,*)    "Compact price-sensitivity table"
 528      cmTableQty(cmScen,r)   "Coupled: mass timber qty (1000 m3)"
 529      cmTableRev(cmScen,r)   "Coupled: CLT+Glulam rev (MILLION $)"
 530      cmObj(cmScen)          "Coupled: objective (MILLION $)"
 531      cmTotQty(cmScen)       "Coupled: total MT qty (1000 m3)"
 532      cmTotRev(cmScen)       "Coupled: total MT rev (MILLION $)"
 533      cmForPlot(cmScen,*)    "Compact coupled-sensitivity table"
 534      pubSummaryTab(pubRow,tabSumCol)"Policy table"
 535      regionalHarvestDem(demScen,r,y) "Roundwood harvest M m3/yr by demand scenario (D50..), region, year — filled in SS10b loop; MNR harvest response to MT demand shocks";
 536   
 537  tierMetrics(r,m,'Production',y) =
 538      sum(p$(manufacturingTier(p)=ord(m)), production.l(r,p,y));
 539   
 540  tierMetrics(r,m,'Revenue',y) =
 541      sum(p$(manufacturingTier(p)=ord(m)), price.l(r,p,y) * sales.l(r,p,y));
 542   
 543  tierMetrics(r,m,'ProcessingCost',y) =
 544      sum(p$(manufacturingTier(p)=ord(m)), processingCost_y(p,y) * production.l(r,p,y));
 545   
 546  productChainCost(p,'BaseProcessing',y) =
 547        baseProcessingCost('Primary')$(manufacturingTier(p)=1)
 548      + baseProcessingCost('Secondary')$(manufacturingTier(p)=2);
 549   
 550  productChainCost(p,'ProductMarkup',y) = productMarkup(p);
 551  productChainCost(p,'LumberInputCost',y) = basePrice_y('Lumber',y) * lumberInputPerUnit(p);
 552  productChainCost(p,'Total',y) = processingCost_y(p,y);
 553   
 554  revRPY(r,p,y) = price.l(r,p,y) * sales.l(r,p,y);
 555  revR(r)       = sum((p,y), revRPY(r,p,y));
 556  rev2025(r)    = sum(p, revRPY(r,p,'2025'));
 557   
 558  DISPLAY
 559      obj.l, Zprofit.l, Zemission.l, carbonCost.l,
 560      tierMetrics,
 561      price.l, stockRW.l, harvestRW.l, production.l, exports.l, sales.l,
 562      revenue.l, harvestCostTot.l, procCostTot.l, transCostTot.l,
 563      revR, rev2025, tierMetrics;
 564   
 565  * =========================================================================
 566  * 10b. DEMAND CHANGE — TABLE BY SIX REGIONS (mass timber qty + direct $)
 567  *     Qty: model is MILLION m3 -> multiply sum by 1000 for 1000 m3 units
 568  *     Solves use solprint=off so .lst is not buried in pages of solver output
 569  *     carbonPrice fixed to cp170 here so demSummary aligns with BaselineRef carbon policy
 570  *     regionalHarvestDem(demScen,r,y): behavioral harvest path per demand shock (Baseline,D50,...)
 571  * =========================================================================
 572  OPTION solprint=off, limrow=0, limcol=0;
 573  carbonPrice = cpValue('cp170');
 574  put_utility 'log' / '=== Starting demand sensitivity (demScen loop) ===';
 575  LOOP(demScen,
 576      demandCap_y(r,p,y) = demandCapBase(r,p,y) * demDemandMult(demScen,p);
 577      SOLVE ForestCP USING NLP MAXIMIZING obj;
 578      demObj(demScen) = obj.l;
 579      demTableQty(demScen,r) =
 580          sum(y, production.l(r,'CLT',y) + production.l(r,'Glulam',y)) * 1000;
 581      demTableRev(demScen,r) =
 582          sum(y, price.l(r,'CLT',y) * sales.l(r,'CLT',y)
 583                + price.l(r,'Glulam',y) * sales.l(r,'Glulam',y));
 584      demSummary(demScen,'Obj')             = obj.l;
 585      demSummary(demScen,'Zprofit')         = Zprofit.l;
 586      demSummary(demScen,'Zemission')       = Zemission.l;
 587      demSummary(demScen,'CarbonStorage')   = Zstorage.l;
 588      demSummary(demScen,'NetCarbon')       = ZnetCarbon.l;
 589      demSummary(demScen,'CarbonCost')      = carbonCost.l;
 590      demSummary(demScen,'Revenue')         = revenue.l;
 591      demSummary(demScen,'HarvestCost')     = harvestCostTot.l;
 592      demSummary(demScen,'ProcCost')        = procCostTot.l;
 593      demSummary(demScen,'TransCost')       = transCostTot.l;
 594      demSummary(demScen,'TotalHarvest')    = sum((r,y), harvestRW.l(r,y));
 595      demSummary(demScen,'TotalProduction') = sum((r,p,y), production.l(r,p,y));
 596      demSummary(demScen,'TotalSales')      = sum((r,p,y), sales.l(r,p,y));
 597      regionalHarvestDem(demScen,r,y)       = harvestRW.l(r,y);
 598  );
 599  * NetCarbon delta / % vs Baseline demand (same cp170); shows policy lever when primal is fixed under carbon tax
 600  LOOP(demScen,
 601      demSummary(demScen,'NetCarbDel') = demSummary(demScen,'NetCarbon') - demSummary('Baseline','NetCarbon');
 602  );
 603  LOOP(demScen,
 604      demSummary(demScen,'NetCarbPct')$(abs(demSummary('Baseline','NetCarbon')) > 1e-6)
 605          = 100 * demSummary(demScen,'NetCarbDel') / abs(demSummary('Baseline','NetCarbon'));
 606  );
 607  demSummary(demScen,'NetCarbPct')$(abs(demSummary('Baseline','NetCarbon')) <= 1e-6) = 0;
 608   
 609  demTotQty(demScen) = sum(r, demTableQty(demScen,r));
 610  demTotRev(demScen) = sum(r, demTableRev(demScen,r));
 611  demForPlot(demScen,'CLTmult')   = demDemandMult(demScen,'CLT');
 612  demForPlot(demScen,'TotQty1k')  = demTotQty(demScen);
 613  demForPlot(demScen,'TotRevM')   = demTotRev(demScen);
 614  demForPlot(demScen,'Obj')       = demObj(demScen);
 615   
 616  demForChart(demScen,'DemandMultiplierCLTGlulam') = demDemandMult(demScen,'CLT');
 617  demForChart(demScen,'Obj')             = demSummary(demScen,'Obj');
 618  demForChart(demScen,'Zprofit')         = demSummary(demScen,'Zprofit');
 619  demForChart(demScen,'Zemission')       = demSummary(demScen,'Zemission');
 620  demForChart(demScen,'CarbonCost')      = demSummary(demScen,'CarbonCost');
 621  demForChart(demScen,'Revenue')         = demSummary(demScen,'Revenue');
 622  demForChart(demScen,'HarvestCost')     = demSummary(demScen,'HarvestCost');
 623  demForChart(demScen,'ProcCost')        = demSummary(demScen,'ProcCost');
 624  demForChart(demScen,'TransCost')       = demSummary(demScen,'TransCost');
 625  demForChart(demScen,'TotalHarvest')    = demSummary(demScen,'TotalHarvest');
 626  demForChart(demScen,'TotalProduction') = demSummary(demScen,'TotalProduction');
 627  demForChart(demScen,'TotalSales')      = demSummary(demScen,'TotalSales');
 628   
 629  demSensBase(outMet) = demSummary('Baseline',outMet);
 630  demSensDelta(demScen,outMet,'AbsChange') = demSummary(demScen,outMet) - demSensBase(outMet);
 631  demSensDelta(demScen,outMet,'PctChange')$demSensBase(outMet) = 100 * demSensDelta(demScen,outMet,'AbsChange') / demSensBase(outMet);
 632   
 633  put_utility 'log' / '=== Demand sensitivity: search .lst for demTableQty / demForPlot ===';
 634  demandCap_y(r,p,y) = demandCapBase(r,p,y);
 635  * Re-solve baseline so exports and carbon loop start from baseline levels
 636  SOLVE ForestCP USING NLP MAXIMIZING obj;
 637  tierMetrics(r,m,'Production',y) =
 638      sum(p$(manufacturingTier(p)=ord(m)), production.l(r,p,y));
 639  tierMetrics(r,m,'Revenue',y) =
 640      sum(p$(manufacturingTier(p)=ord(m)), price.l(r,p,y) * sales.l(r,p,y));
 641  tierMetrics(r,m,'ProcessingCost',y) =
 642      sum(p$(manufacturingTier(p)=ord(m)), processingCost_y(p,y) * production.l(r,p,y));
 643  revRPY(r,p,y) = price.l(r,p,y) * sales.l(r,p,y);
 644  revR(r)       = sum((p,y), revRPY(r,p,y));
 645  rev2025(r)    = sum(p, revRPY(r,p,'2025'));
 646   
 647  * =========================================================================
 648  * 10b1. REGIONAL HARVEST BY YEAR — BY DEMAND SCENARIO (MNR / policy tables)
 649  *     One matrix per demScen (Baseline, D50, D100, ...) from SS10b solves.
 650  *     demandCap_y = demandCapBase * demDemandMult (MT demand shock); demandCapBase
 651  *     embeds stochastic demandShock(r,p,y). Also harvestCostShock, growthShock.
 652  *     carbonPrice = 170 throughout SS10b. Units: MILLION m3 per year (not cumulative).
 653  * =========================================================================
 654  DISPLAY regionalHarvestDem;
 655   
 656  file hrvrep / 'output/regional_harvest_by_year_demand_scenarios.txt' /;
 657  hrvrep.pc = 5;
 658  hrvrep.nd = 12;
 659  put hrvrep;
 660  put 'Regional roundwood harvest by year — BY DEMAND SCENARIO (MILLION m3 per year)'/;
 661  put 'Each block = equilibrium after solving with that demScen (CLT/Glulam cap multipliers)'/;
 662  put 'Underlying caps: demandCapBase * demDemandMult; demandCapBase includes demandShock(r,p,y)'/;
 663  put 'Other variability: harvestCostShock(r,y), growthShock(r,y). Carbon price = 170 $/tCO2.'/;
 664  put 'Reproducibility: gams SA13.gms --seed=<integer>'/;
 665  put /;
 666  loop(demScen,
 667      put '=== Demand scenario: ' demScen.tl
 668          '  CLT mult ' demDemandMult(demScen,'CLT'):8:4 /;
 669      put 'Region':20;
 670      loop(y,
 671          put y.tl:10;
 672      );
 673      put /;
 674      loop(r,
 675          put r.tl:20;
 676          loop(y,
 677              put regionalHarvestDem(demScen,r,y):10:4;
 678          );
 679          put /;
 680      );
 681      put '  Horizon sum by region (M m3):'/;
 682      loop(r,
 683          put '    ' r.tl:18;
 684          put sum(y, regionalHarvestDem(demScen,r,y)):12:4 /;
 685      );
 686      put /;
 687  );
 688  putclose hrvrep;
 689  put_utility 'log' / 'Wrote output/regional_harvest_by_year_demand_scenarios.txt';
 690   
 691  file hrvcsv / 'output/regional_harvest_by_year_demand_scenarios_long.csv' /;
 692  hrvcsv.pc = 5;
 693  put hrvcsv;
 694  put 'demScen,CLT_cap_mult,Region,Year,Harvest_Mm3_per_year'/;
 695  loop(demScen,
 696      loop(r,
 697          loop(y,
 698              put demScen.tl;
 699              put ',';
 700              put demDemandMult(demScen,'CLT'):0:6;
 701              put ',';
 702              put r.tl;
 703              put ',';
 704              put y.tl;
 705              put ',';
 706              put regionalHarvestDem(demScen,r,y):0:8;
 707              put /;
 708          );
 709      );
 710  );
 711  putclose hrvcsv;
 712  put_utility 'log' / 'Wrote output/regional_harvest_by_year_demand_scenarios_long.csv';
 713   
 714  Execute_Unload "output/RegionalHarvestByYear.gdx", demScen, r, y, regionalHarvestDem, demDemandMult;
 715  put_utility 'log' / 'Wrote output/RegionalHarvestByYear.gdx';
 716   
 717  * One DISPLAY block — search .lst for "demTableQty", "demSummary", or "demForPlot"
 718  DISPLAY demDemandMult, demForPlot, demTotQty, demTotRev, demObj, demTableQty, demTableRev;
 719  DISPLAY demSummary, demForChart;
 720  DISPLAY demSensBase, demSensDelta;
 721   
 722  file demrep / 'output/demand_sensitivity_report.txt' /;
 723  demrep.pc = 5;
 724  demrep.nd = 12;
 725  put demrep;
 726  put 'Demand sensitivity - mass timber (CLT+Glulam), 6 regions, sum over years'/;
 727  put 'Qty = 1000 m3 ; Rev = MILLION $'/;
 728  put /;
 729  loop(demScen,
 730      put 'Scenario: ' demScen.tl /;
 731      put '  CLT mult ' demDemandMult(demScen,'CLT'):12:4
 732          '  Obj ' demObj(demScen):12:4
 733          '  TotQty(1000m3) ' demTotQty(demScen):12:2
 734          '  TotRev(M$) ' demTotRev(demScen):12:4 /;
 735      loop(r,
 736          put '  ' r.tl:12
 737              ' Qty ' demTableQty(demScen,r):12:2
 738              ' Rev ' demTableRev(demScen,r):12:4 /;
 739      );
 740      put /;
 741  );
 742  putclose demrep;
 743  put_utility 'log' / 'Wrote output/demand_sensitivity_report.txt';
 744   
 745  Execute_Unload "output/DemandChangeByRegion.gdx",
 746      demScen, demDemandMult, demTableQty, demTableRev,
 747      demObj, demTotQty, demTotRev, demForPlot,
 748      demSummary, demForChart, demSensBase, demSensDelta,
 749      regionalHarvestDem;
 750   
 751  * =========================================================================
 752  * 10c. LUMBER PRICE SENSITIVITY — same regional MT table as demand block
 753  * =========================================================================
 754  put_utility 'log' / '=== Starting lumber price sensitivity (prScen) ===';
 755  LOOP(prScen,
 756      demandCap_y(r,p,y) = demandCapBase(r,p,y);
 757      basePrice_y(p,y) = basePricePath(p,y);
 758      basePrice_y('Lumber',y) = basePricePath('Lumber',y) * prLumberMult(prScen);
 759      price.fx(r,p,y) = basePrice_y(p,y);
 760      SOLVE ForestCP USING NLP MAXIMIZING obj;
 761      prObj(prScen) = obj.l;
 762      prTableQty(prScen,r) =
 763          sum(y, production.l(r,'CLT',y) + production.l(r,'Glulam',y)) * 1000;
 764      prTableRev(prScen,r) =
 765          sum(y, price.l(r,'CLT',y) * sales.l(r,'CLT',y)
 766                + price.l(r,'Glulam',y) * sales.l(r,'Glulam',y));
 767  );
 768  prTotQty(prScen) = sum(r, prTableQty(prScen,r));
 769  prTotRev(prScen) = sum(r, prTableRev(prScen,r));
 770  prForPlot(prScen,'LumberMult') = prLumberMult(prScen);
 771  prForPlot(prScen,'TotQty1k')   = prTotQty(prScen);
 772  prForPlot(prScen,'TotRevM')    = prTotRev(prScen);
 773  prForPlot(prScen,'Obj')        = prObj(prScen);
 774  basePrice_y(p,y) = basePricePath(p,y);
 775  price.fx(r,p,y) = basePrice_y(p,y);
 776  demandCap_y(r,p,y) = demandCapBase(r,p,y);
 777  SOLVE ForestCP USING NLP MAXIMIZING obj;
 778  tierMetrics(r,m,'Production',y) =
 779      sum(p$(manufacturingTier(p)=ord(m)), production.l(r,p,y));
 780  tierMetrics(r,m,'Revenue',y) =
 781      sum(p$(manufacturingTier(p)=ord(m)), price.l(r,p,y) * sales.l(r,p,y));
 782  tierMetrics(r,m,'ProcessingCost',y) =
 783      sum(p$(manufacturingTier(p)=ord(m)), processingCost_y(p,y) * production.l(r,p,y));
 784  revRPY(r,p,y) = price.l(r,p,y) * sales.l(r,p,y);
 785  revR(r)       = sum((p,y), revRPY(r,p,y));
 786  rev2025(r)    = sum(p, revRPY(r,p,'2025'));
 787   
 788  DISPLAY prLumberMult, prForPlot, prTotQty, prTotRev, prObj, prTableQty, prTableRev;
 789   
 790  file prrep / 'output/price_sensitivity_report.txt' /;
 791  prrep.pc = 5;
 792  prrep.nd = 12;
 793  put prrep;
 794  put 'Lumber price sensitivity - mass timber (CLT+Glulam), 6 regions, sum over years'/;
 795  put 'Qty = 1000 m3 ; Rev = MILLION $ ; LumberMult = shock to lumber price path'/;
 796  put /;
 797  loop(prScen,
 798      put 'Scenario: ' prScen.tl /;
 799      put '  LumberMult ' prLumberMult(prScen):12:4
 800          '  Obj ' prObj(prScen):12:4
 801          '  TotQty(1000m3) ' prTotQty(prScen):12:2
 802          '  TotRev(M$) ' prTotRev(prScen):12:4 /;
 803      loop(r,
 804          put '  ' r.tl:12
 805              ' Qty ' prTableQty(prScen,r):12:2
 806              ' Rev ' prTableRev(prScen,r):12:4 /;
 807      );
 808      put /;
 809  );
 810  putclose prrep;
 811  put_utility 'log' / 'Wrote output/price_sensitivity_report.txt';
 812   
 813  Execute_Unload "output/PriceChangeByRegion.gdx",
 814      prScen, prLumberMult, prTableQty, prTableRev,
 815      prObj, prTotQty, prTotRev, prForPlot;
 816   
 817  * =========================================================================
 818  * 10d. COUPLED SENSITIVITY — MT demand shift + lumber price shock together
 819  * =========================================================================
 820  put_utility 'log' / '=== Starting coupled sensitivity (cmScen) ===';
 821  LOOP(cmScen,
 822      demandCap_y(r,p,y) = demandCapBase(r,p,y) * cmDemandMult(cmScen,p);
 823      basePrice_y(p,y) = basePricePath(p,y);
 824      basePrice_y('Lumber',y) = basePricePath('Lumber',y) * cmLumberMult(cmScen);
 825      price.fx(r,p,y) = basePrice_y(p,y);
 826      SOLVE ForestCP USING NLP MAXIMIZING obj;
 827      cmObj(cmScen) = obj.l;
 828      cmTableQty(cmScen,r) =
 829          sum(y, production.l(r,'CLT',y) + production.l(r,'Glulam',y)) * 1000;
 830      cmTableRev(cmScen,r) =
 831          sum(y, price.l(r,'CLT',y) * sales.l(r,'CLT',y)
 832                + price.l(r,'Glulam',y) * sales.l(r,'Glulam',y));
 833  );
 834  cmTotQty(cmScen) = sum(r, cmTableQty(cmScen,r));
 835  cmTotRev(cmScen) = sum(r, cmTableRev(cmScen,r));
 836  cmForPlot(cmScen,'CLTmult')     = cmDemandMult(cmScen,'CLT');
 837  cmForPlot(cmScen,'LumberMult')  = cmLumberMult(cmScen);
 838  cmForPlot(cmScen,'TotQty1k')    = cmTotQty(cmScen);
 839  cmForPlot(cmScen,'TotRevM')     = cmTotRev(cmScen);
 840  cmForPlot(cmScen,'Obj')         = cmObj(cmScen);
 841  demandCap_y(r,p,y) = demandCapBase(r,p,y);
 842  basePrice_y(p,y) = basePricePath(p,y);
 843  price.fx(r,p,y) = basePrice_y(p,y);
 844  SOLVE ForestCP USING NLP MAXIMIZING obj;
 845  tierMetrics(r,m,'Production',y) =
 846      sum(p$(manufacturingTier(p)=ord(m)), production.l(r,p,y));
 847  tierMetrics(r,m,'Revenue',y) =
 848      sum(p$(manufacturingTier(p)=ord(m)), price.l(r,p,y) * sales.l(r,p,y));
 849  tierMetrics(r,m,'ProcessingCost',y) =
 850      sum(p$(manufacturingTier(p)=ord(m)), processingCost_y(p,y) * production.l(r,p,y));
 851  revRPY(r,p,y) = price.l(r,p,y) * sales.l(r,p,y);
 852  revR(r)       = sum((p,y), revRPY(r,p,y));
 853  rev2025(r)    = sum(p, revRPY(r,p,'2025'));
 854   
 855  DISPLAY cmDemandMult, cmLumberMult, cmForPlot, cmTotQty, cmTotRev, cmObj, cmTableQty, cmTableRev;
